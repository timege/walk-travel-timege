+    private fun drawSeaOpenings(canvas: Canvas, currentMap: MapLibreMap, cacheW: Int, cacheH: Int) {
+        val targetLongitude = currentMap.cameraPosition.target?.longitude ?: return
+        for (polygon in seaPolygons) {
